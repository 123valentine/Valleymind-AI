# Valleymind-AI Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Groq (free tier) ────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ── NVIDIA NIM (free tier) ──────────────────────────────────────────
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY_FALLBACK=

# ── OpenRouter (free models only) ───────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY_FALLBACK=

# ── Gemini (Google Generative AI) ───────────────────────────────────
# Use either GEMINI_API_KEY or GOOGLE_GENERATIVE_AI_API_KEY
GEMINI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# ── TinyFish Search (free tier) ─────────────────────────────────────
TINYFISH_API_KEY=

# ── Search APIs (optional) ──────────────────────────────────────────
NEWSCATCHER_API_KEY=
CURRENTS_API_KEY=
API_SPORTS_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# ── Database ────────────────────────────────────────────────────────
MONGODB_URI=
PINECONE_API_KEY=
PINECONE_API_KEY_MEMORY=
PINECONE_INDEX_MEMORY=valleymind-memory
PINECONE_API_KEY_KNOWLEDGE=
PINECONE_INDEX_KNOWLEDGE=valleymind-knowledge
EMBEDDING_MODEL=openai/text-embedding-3-large
EMBEDDING_DIMS=768
PINECONE_REGION=us-west1

# ── Media / R2 ──────────────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=valleymind-media
R2_ENDPOINT=
VIDEO_BUDGET_USD=100

# ── Other ───────────────────────────────────────────────────────────
ALIBABA_MODEL_STUDIO_API_KEY=
RESEND_API_KEY=
EMAIL_FROM_NAME=ValleyMind
EMAIL_FROM=
APP_BASE_URL=
VIRUSTOTAL_API_KEY=
API_KEY=
