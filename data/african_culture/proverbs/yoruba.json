    {
      "id": "yoruba-000002",
      "culture": "yoruba",
      "text": "Ìyá ò ní bí ọmọ bá ká kù.",
      "translation_en": "A mother does not give up on her child.",
      "meaning": "Perseverance, parental devotion, and persistence.",
      "themes": [
        "family",
        "perseverance",
        "love"
      ],
