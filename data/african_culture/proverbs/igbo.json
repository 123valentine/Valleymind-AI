    },
    {
      "id": "igbo-000003",
      "culture": "igbo",
      "text": "Ewu na-eri nri, ọ naghị eche na ọ ga-ata ụfụ.",
      "translation_en": "A goat eats when it can, not knowing what suffering lies ahead.",
      "meaning": "We cannot control the future, only make the most of the present.",
      "themes": [
        "patience",
        "present",
        "contentment"
      ],
      "source": {
