    {
      "id": "igbo-000001",
      "culture": "igbo",
      "text": "Onye were ndụ, were aka ya ruo ọdụ.",
      "translation_en": "When a person is alive, they will use their hands to reach the tail.",
      "meaning": "As long as there is life, there is still hope and a chance to achieve.",
      "themes": [
        "perseverance",
        "hope",
        "patience"
      ],
      "source": {
