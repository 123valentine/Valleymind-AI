<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The web app + companion need the network. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The floating companion is drawn over OTHER apps: this is the Android
         permission the user must grant ("Display over other apps"). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Keep the overlay alive while the user is in other apps. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- The foreground-service notification (Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Voice conversation reuses the existing site voice pipeline. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- No CAMERA permission on purpose: image capture is delegated to the
         user's camera app via ACTION_IMAGE_CAPTURE, which handles its own
         permission. Declaring CAMERA here would make that intent require a
         runtime grant this app never asks for and the capture would fail. -->

    <!-- Package visibility (Android 11+): without this, resolveActivity() for
         the capture intent returns null even when a camera app is installed. -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ValleyMind">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize|uiMode"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Hands the camera app a private, write-only-by-grant URI for the photo
             it captures; the file stays inside this app's cache directory. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- The system-wide floating companion. Not exported: only this app can
             start it. The specialUse type is required on Android 14+ and is
             declared with the required subtype property. -->
        <service
            android:name=".CompanionOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-enabled floating AI companion overlay shown over other apps" />
        </service>
    </application>

</manifest>
