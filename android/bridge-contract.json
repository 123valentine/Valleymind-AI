{
  "version": 2,
  "compatibility": "additive-only",
  "description": "Native bridge contract for the ValleyMind Android shell. Existing native methods, shim methods, event names and overlay markers must never be renamed or removed; new behaviour is advertised through capabilities and callers must feature-detect.",
  "nativeMethods": [
    "isOverlaySupported",
    "hasPermission",
    "requestPermission",
    "getStateJson",
    "setVisible",
    "notifyBridgeReady",
    "ttsSpeak",
    "ttsSpeakV2",
    "ttsStop",
    "cameraSupported",
    "cameraStart",
    "cameraStop",
    "cameraSwitch",
    "cameraStateJson",
    "cameraCapture",
    "asrSupported",
    "asrStart",
    "asrStop",
    "asrCancel",
    "contractJson",
    "capabilitiesJson",
    "setOverlayRegion",
    "getOverlayRegion",
    "screenContextSupported",
    "screenContextJson",
    "screenContextSettings"
  ],
  "shimMethods": [
    "isSupported",
    "hasPermission",
    "requestPermission",
    "getState",
    "getVisible",
    "setVisible",
    "onCompanionVisibility",
    "hasNativeTts",
    "ttsSpeak",
    "ttsStop",
    "hasNativeTtsV2",
    "ttsSpeakV2",
    "onSpeechEvent",
    "hasNativeCamera",
    "cameraStart",
    "cameraStop",
    "cameraSwitch",
    "cameraState",
    "cameraCapture",
    "hasNativeAsr",
    "asrStart",
    "asrStop",
    "asrCancel",
    "onAsrEvent",
    "screenContextSupported",
    "screenContextJson",
    "screenContextSettings"
  ],
  "capabilities": [
    "overlay",
    "overlayRegion",
    "tts",
    "ttsEvents",
    "camera",
    "asr",
    "files",
    "liveCall",
    "dragPersistence",
    "screenContext"
  ],
  "events": [
    "__vmAndroidState",
    "__vmAsrEvent",
    "__vmTtsDone_",
    "__vmSpeechEvent_",
    "__vmCameraResult_",
    "__vmCameraState"
  ],
  "overlayMarkers": [
    "vmOverlayRoot",
    "stage",
    "btnHide"
  ]
}
